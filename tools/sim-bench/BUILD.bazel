# The GPU benchmark as a Bazel test on a DGX Spark: the CLI cross-compiled for aarch64 here, run
# on the gb10 executor. `bazel test --config=remote //tools/sim-bench:gb10`; the JSON lands in the
# test's undeclared outputs (outputs.zip in BuildBuddy).

load("//tools/bazel:gpu_test.bzl", "gb10_test", "rtx4090_run")
load("@rules_platform//platform_data:defs.bzl", "platform_data")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

platform_data(
    name = "solidcraft-cli-aarch64",
    platform = "//platforms:linux_aarch64",
    target = "//apps/solidcraft-cli:solidcraft-cli",
)

# The same on a Windows workstation with an RTX 4090 (BuildBuddy pool `rtx4090`, a bare
# executor started by hand there: see README.md), as a build action rather than a test: the
# Windows test wrapper only ships with a Windows Bazel. `bazel build --config=remote
# //tools/sim-bench:rtx4090` runs it and leaves rtx4090-2.json in bazel-bin; the log is in the
# BuildBuddy invocation's action.
platform_data(
    # Named with the extension Windows wants of an executable.
    name = "solidcraft-cli-windows.exe",
    platform = "//platforms:windows_x86_64",
    target = "//apps/solidcraft-cli:solidcraft-cli",
)

[
    rtx4090_run(
        name = "rtx4090" + ("" if cell == "2" else "-" + cell.replace(".", "_")),
        args = [
            "sim-bench",
            "--cell",
            cell,
            "--steps",
            "3000",
        ],
        binary = ":solidcraft-cli-windows.exe",
        out = "rtx4090-" + cell.replace(".", "_") + ".json",
        tags = ["gpu"],
    )
    for cell in ["2", "1.5"]
]

[
    sh_test(
        name = "gb10" + ("" if cell == "2" else "-" + cell.replace(".", "_")),
        size = "large",
        timeout = "long",
        srcs = ["gb10_test.sh"],
        args = [
            "$(rootpath :solidcraft-cli-aarch64)",
            "--cell",
            cell,
            "--steps",
            "3000",
        ],
        data = [":solidcraft-cli-aarch64"],
        env = {
            "SOLIDCRAFT_GPU": "hardware",
            "SOLIDCRAFT_SIM_DEBUG": "1",
        },
        # The test action's own exec group ("test.") goes to BuildBuddy's gb10 pool: a bare action
        # on the Spark executor, which sees the GPU. (exec_compatible_with does not reach the test
        # exec group, so the platform in //platforms is documentation of the same properties.)
        exec_properties = {
            "test.OSFamily": "linux",
            "test.Arch": "arm64",
            "test.Pool": "gb10",
            "test.workload-isolation-type": "none",
        },
        tags = ["gpu"],
    )
    for cell in ["2", "1.5"]
]

# Any prebuilt binary on the GPU executors (not committed; drop it into prebuilt/). Used for
# FieldCraft's GPU throughput test, cross-compiled with cargo-zigbuild:
#   bazel test --config=remote //tools/sim-bench:prebuilt-gb10 --test_arg=--ignored --test_arg=--nocapture
gb10_test(
    name = "prebuilt-gb10",
    size = "large",
    timeout = "long",
    binary = ":prebuilt_aarch64",
    env = {"FIELDCRAFT_REQUIRE_GPU": "1"},
    exec_properties = {
        "test.OSFamily": "linux",
        "test.Arch": "arm64",
        "test.Pool": "gb10",
        "test.workload-isolation-type": "none",
    },
    tags = [
        "gpu",
        "manual",
    ],
)

rtx4090_run(
    name = "prebuilt-rtx4090",
    args = [
        "--ignored",
        "--nocapture",
    ],
    binary = ":prebuilt_windows",
    env = {"FIELDCRAFT_REQUIRE_GPU": "1"},
    out = "prebuilt-rtx4090.log",
    out_flag = "--logfile",
    tags = [
        "gpu",
        "manual",
    ],
)

filegroup(
    name = "prebuilt_aarch64",
    srcs = glob(["prebuilt/aarch64/*"], allow_empty = True),
)

filegroup(
    name = "prebuilt_windows",
    srcs = glob(["prebuilt/windows/*.exe"], allow_empty = True),
)
