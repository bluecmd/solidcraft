# Platforms for the GPU benchmark on a DGX Spark: the binary is built for aarch64 Linux and the
# test runs on an executor that has a GB10 (BuildBuddy pool `gb10`, bare isolation so the action
# sees the pod's GPU and the Vulkan driver the NVIDIA runtime mounts).

package(default_visibility = ["//visibility:public"])

# A platform that is a GPU executor at all (what tools/bazel/gpu_test.bzl requires of the test
# action's execution platform), and which GPU.
constraint_setting(name = "executor")

constraint_value(
    name = "gpu_executor",
    constraint_setting = ":executor",
)

constraint_setting(name = "gpu")

constraint_value(
    name = "gb10",
    constraint_setting = ":gpu",
)

constraint_value(
    name = "rtx4090",
    constraint_setting = ":gpu",
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

# A Windows workstation with an RTX 4090 running the BuildBuddy executor of pool `rtx4090`
# (tools/sim-bench/README.md); bare isolation, actions run as that user.
platform(
    name = "rtx4090_executor",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        ":gpu_executor",
        ":rtx4090",
    ],
    exec_properties = {
        "OSFamily": "Windows",
        "Pool": "rtx4090",
        "workload-isolation-type": "none",
    },
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "gb10_executor",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":gpu_executor",
        ":gb10",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "Arch": "arm64",
        "Pool": "gb10",
        "workload-isolation-type": "none",
    },
)
