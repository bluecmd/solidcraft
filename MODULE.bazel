"""Bazel build of SolidCraft, beside Cargo: the same Cargo.lock, resolved by crate_universe, with
BUILD files generated from the manifests (tools/bazel/generate_build.py). Its purpose is remote
execution: the CLI is cross-compiled here for aarch64 and the GPU benchmark runs as a test on a
DGX Spark executor (//tools/sim-bench:gb10), results in BuildBuddy."""

module(name = "solidcraft")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_platform", version = "0.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# One stable Rust for the host plus the aarch64 Linux target: rules_rust downloads rust-std for
# both and registers a toolchain per (exec, target) pair.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-gnu",
    ],
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates straight from Cargo.lock. The workspace members are found from the root
# manifest; the vendored patches of truck and egui-wgpu (path dependencies that are not members)
# get BUILD files generated in place under vendor/.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# khronos_api's build script (wgpu's GL backend on Windows) embeds the WebGL extension XMLs by
# absolute paths into its own working directory, which the compile action does not see; the
# patch copies them beside the generated file and names them relatively.
crate.annotation(
    crate = "khronos_api",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/patches:khronos_api-build.patch"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# The aarch64 linker: zig's cc, hermetic, targeting glibc 2.28 (older than any node's), the same
# trick cargo-zigbuild plays for the container image. The host keeps its own C toolchain.
zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains("@zig_sdk//toolchain:linux_arm64_gnu.2.28")

# The Windows linker: llvm-mingw (clang + lld + mingw-w64 CRT), hosted on Linux, for
# x86_64-pc-windows-gnu; see tools/bazel/llvm_mingw/. rustc's windows-gnu target expects GCC's
# runtime libraries, which llvm-mingw does not have: an empty libgcc.a (compiler-rt's builtins
# are linked by clang itself) and LLVM libunwind under the libgcc_eh/libgcc_s names (the same
# _Unwind_* entry points) let the stock target link unchanged.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

LLVM_MINGW_RELEASE = "20260908"

http_archive(
    name = "llvm_mingw",
    build_file = "//tools/bazel/llvm_mingw:llvm_mingw.BUILD",
    patch_cmds = [
        # rustc looks for `dlltool` beside the linker for raw-dylib imports (getrandom, windows-sys).
        "ln -s llvm-dlltool bin/dlltool",
        "bin/llvm-ar rc x86_64-w64-mingw32/lib/libgcc.a",
        "cp x86_64-w64-mingw32/lib/libunwind.a x86_64-w64-mingw32/lib/libgcc_eh.a",
        "cp x86_64-w64-mingw32/lib/libunwind.a x86_64-w64-mingw32/lib/libgcc_s.a",
    ],
    sha256 = "4d905bae713182f1a2b4d33875fe5aa544ce9fc04cc153acb47755a90ca62f16",
    strip_prefix = "llvm-mingw-{r}-msvcrt-ubuntu-22.04-x86_64".format(r = LLVM_MINGW_RELEASE),
    urls = ["https://github.com/mstorsjo/llvm-mingw/releases/download/{r}/llvm-mingw-{r}-msvcrt-ubuntu-22.04-x86_64.tar.xz".format(r = LLVM_MINGW_RELEASE)],
)

register_toolchains("@llvm_mingw//:windows_x86_64_cc_toolchain")
