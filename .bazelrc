# Outputs per platform (host and aarch64 trees side by side).
build --experimental_platform_in_output_dir

# BuildBuddy (apps/buildbuddy in argocd-apps): build events and the remote cache always, so an
# invocation shows up at the URL below; remote execution only with --config=remote.
build --bes_results_url=https://buildbuddy.k8s.mainframe.dev/invocation/
build --bes_backend=grpc://100.99.0.75:1985
build --remote_cache=grpc://100.99.0.75:1985
build --remote_timeout=10m
build --remote_cache_compression
build --remote_upload_local_results

# The GB10 executor (pool gb10 on a DGX Spark) is an execution platform behind the host, so only
# targets that require //platforms:gb10 (the GPU benchmark test) resolve to it; everything else
# builds here. `bazel test --config=remote //tools/sim-bench:gb10` runs the benchmark there.
build --extra_execution_platforms=@platforms//host,//platforms:gb10_executor
build:remote --remote_executor=grpc://100.99.0.75:1985
build:remote --jobs=32
build:remote --remote_download_toplevel

# In-cluster (GitLab CI) address of the same service.
build:in-cluster --bes_backend=grpc://buildbuddy.buildbuddy.svc.cluster.local:1985
build:in-cluster --remote_cache=grpc://buildbuddy.buildbuddy.svc.cluster.local:1985
build:in-cluster --remote_executor=grpc://buildbuddy.buildbuddy.svc.cluster.local:1985

test --test_output=errors

try-import %workspace%/user.bazelrc
